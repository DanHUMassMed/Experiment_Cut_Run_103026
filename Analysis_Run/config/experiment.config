/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Experiment Configuration for CUT&RUN Downstream Peak Analysis
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Run from Analysis_Run/:
      ./run.sh
    or:
      nextflow -c config/experiment.config run ../nf-cutandrun -resume
----------------------------------------------------------------------------------------
*/

params {
    // =========================================================================
    // Experiment & Input / Output Paths
    // =========================================================================
    email                          = "daniel.higgins@umassmed.edu"
    experiment                     = "cut_run103026"
    input_dir                      = "/Users/dan/UMass Medical School Dropbox/Daniel Higgins/Walker_lab_shared/Bioinformatics_parent/${params.experiment}"
    bigwig_source                  = "06_index_bam"          // '06_index_bam' (bamCoverage RPKM) or '08_bigwig' (bedGraphToBigWig)
    outdir                         = "${launchDir}/results/${params.experiment}"
    samplesheet                    = "${launchDir}/config/samplesheet.csv"

    // =========================================================================
    // Step Toggles (Turn individual downstream peak analysis outputs on/off)
    // =========================================================================
    // Step c: Calling peaks (MACS2 and/or HOMER)
    run_macs2_callpeak             = true
    run_homer_findpeaks            = true

    // Step d: Merging peak files using bedtools
    run_merge_replicate_peaks      = true
    run_merge_master_peaks         = true

    // Step e: Peak-by-peak analysis using HOMER
    run_homer_annotatepeaks        = true

    // Step f: Calling differential peaks using HOMER
    run_homer_diffpeaks            = true

    // Step g: Making metapeak plots (tornado plots) with deepTools
    run_deeptools_metapeak         = true

    // Step h: Looking for enriched motifs in peaks
    run_homer_findmotifs           = true
    run_meme_streme                = true

    // Step i: Automated QC & summary plots (15_summary_plots)
    run_summary_plots              = true

    // Step d: bedtools replicate & condition peak merging
    active_peak_caller             = "macs2"                 // 'macs2' or 'homer'
    min_replicate_overlap          = 2

    // =========================================================================
    // Input Globs (Dropbox inputs & local peak fallbacks when toggles are false)
    // =========================================================================
    input_bam                      = "${params.input_dir}/06_index_bam/*.bam"
    input_tagdirs                  = "${params.input_dir}/07_ucsc/*"
    input_bigwig                   = "${params.input_dir}/${params.bigwig_source}/*.bw"
    input_sample_peaks             = "${params.outdir}/09_peaks/${params.active_peak_caller}/*_peaks.{narrowPeak,broadPeak,bed}"
    input_replicated_peaks         = "${params.outdir}/10_merged_peaks/replicates/*_replicated_peaks.bed"
    input_peaks_bed                = "${params.outdir}/10_merged_peaks/master/*_master_peaks.bed"
    input_annotated_peaks          = "${params.outdir}/11_peak_quantification/*_annotated_peaks.txt"
    input_diff_peaks               = "${params.outdir}/12_differential_peaks/*_differential_peaks.txt"

    // =========================================================================
    // Tool-Specific Parameters
    // =========================================================================
    // Genome Reference Settings (C. elegans defaults; change to mm10/hg38/dm6 if needed)
    genome_name                    = "ce11"
    homer_dir                      = "${projectDir}/assets/homer_ce11"
    genome_fasta                   = "${projectDir}/assets/homer_ce11/data/genomes/ce11"
    chrom_sizes                    = "${projectDir}/assets/homer_ce11/data/genomes/ce11/chrom.sizes"

    // Step c: MACS2 parameters
    macs2_gsize                    = "ce"                    // hs, mm, ce, dm, or numeric size
    macs2_format                   = "BAMPE"
    macs2_qvalue                   = 0.01
    macs2_broad                    = false
    macs2_broad_cutoff             = 0.1

    // Step c: HOMER findPeaks parameters
    homer_peak_style               = "factor"                // 'factor' or 'histone'

    // Step e: HOMER annotatePeaks
    annotatepeaks_size             = "given"

    // Step f: HOMER getDifferentialPeaksReplicates contrasts
    diff_contrasts                 = [
        [ id: 'EV_INT_vs_N2_H3K4me3',    treatment: 'EV_INT_H3K4me3',    background: 'N2_H3K4me3',    target: 'H3K4me3' ],
        [ id: 'EV_INT_MC_vs_N2_H3K4me3', treatment: 'EV_INT_MC_H3K4me3', background: 'N2_H3K4me3',    target: 'H3K4me3' ],
        [ id: 'EV_INT_vs_N2_H3K27me3',   treatment: 'EV_INT_H3K27me3',   background: 'N2_H3K27me3',   target: 'H3K27me3' ]
    ]

    // Step g: deepTools computeMatrix & plotHeatmap
    metapeak_upstream              = 2000
    metapeak_downstream            = 2000
    metapeak_reference_point       = "center"
    heatmap_colormap               = "inferno"
    heatmap_interpolation          = "nearest"

    // Step h: Motif discovery (HOMER & MEME STREME)
    homer_motif_size               = "100"
    meme_slop_left                 = 50
    meme_slop_right                = 49
    meme_streme_nmotifs            = 20

    // Step i: Automated QC & Summary Plots (15_summary_plots)
    volcano_fdr_threshold          = 0.05
    volcano_log2fc_threshold       = 1.0
    volcano_top_n_labels           = 12
}

process {
    withName: 'DEEPTOOLS_METAPEAK' {
        ext.args = {
            [
                "-a ${params.metapeak_downstream}",
                "-b ${params.metapeak_upstream}",
                "--referencePoint ${params.metapeak_reference_point}",
                "--binSize 20",
                "--missingDataAsZero",
                "--skipZeros"
            ].join(' ')
        }
    }
}
